{
	"compilerOptions": {
		"declaration": true,
		"types": ["node", "mocha"],
		"declarationMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"importHelpers": true,
		"lib": ["es2022", "es5"],
		"moduleResolution": "bundler",
		"noEmitOnError": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noUnusedLocals": true,
		"preserveSymlinks": true,
		"preserveWatchOutput": true,
		"pretty": false,
		"rootDir": "./src.ts",
		"strict": true,
		"sourceMap": true,
		"target": "es2022"
	},
	"exclude": [],
	"include": ["./src.ts/**/*.ts"]
}
